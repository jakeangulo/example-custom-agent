#!/usr/bin/env bash
# Installed as /usr/local/sbin/openclaw-cli by install.sh. Runs the OpenClaw CLI
# the way the gateway runs: as the install user, with the gateway token from the
# root-only env file. Plain `openclaw` as root reads root's own config and gets
# "gateway token mismatch".
#
#   openclaw-cli login     print a one-time, ten-minute link that opens the
#                          Control UI and pairs that browser as administrator
#   openclaw-cli ARGS...   any other OpenClaw command, e.g. `devices list`
set -euo pipefail

ENV_FILE="@ENV_FILE@"
PUBLIC_URL="@PUBLIC_URL@"

[[ -r "$ENV_FILE" ]] || { echo "openclaw-cli: cannot read $ENV_FILE; run it as root" >&2; exit 1; }
set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a

# runuser keeps the environment, so the exported token never goes on a command line.
oc() {
  cd /
  runuser -u "@USER@" -- env HOME="@HOME@" "@OPENCLAW_BIN@" "$@"
}

if [[ "${1:-}" != login ]]; then
  oc "$@"
  exit
fi

# The dashboard link points at loopback for a LAN bind; swap in the public
# address for both the page and the gateway WebSocket it connects to.
url="$(oc dashboard --json | jq -r 'select(.ok == true) | .browserUrl // empty')"
[[ -n "$url" ]] || { echo "openclaw-cli: the gateway did not issue a login link" >&2; exit 1; }
host="${PUBLIC_URL#http://}"
url="${url//http:\/\/127.0.0.1:@PORT@/$PUBLIC_URL}"
url="${url//ws%3A%2F%2F127.0.0.1%3A@PORT@/ws%3A%2F%2F${host//:/%3A}}"
echo "Open this link within 10 minutes; it works once and pairs that browser:"
echo "$url"
