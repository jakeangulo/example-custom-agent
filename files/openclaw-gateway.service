[Unit]
Description=OpenClaw gateway
After=network-online.target docker.service openclaw-metadata-block.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root
Environment=HOME=/root
ExecStart=@OPENCLAW_BIN@ gateway run --port @PORT@ --bind lan
Restart=on-failure
RestartSec=5
# 78 means invalid configuration; restarting would only loop.
RestartPreventExitStatus=78
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
